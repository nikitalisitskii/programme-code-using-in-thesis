def load_russia_contour_map():
    try:
        url = "https://raw.githubusercontent.com/codeforamerica/click_that_hood/master/public/data/russia.geojson"
        ru = gpd.read_file(url)
        new = load_region_polygons()
        if not new.empty:
            ru = pd.concat([ru, new], ignore_index=True)
        ru['name'] = ru['name'].str.replace('Республика ', '').str.replace('область', 'обл.').str.strip()
        return ru
    except Exception as e:
        print("Ошибка загрузки карты:", e)
        return None

def plot_clusters_on_map(df):
    gdf = load_russia_contour_map()
    if gdf is None:
        return
    df = df.copy()
    df['Регион'] = df['Регион'].str.replace('Республика ', '').str.replace('область', 'обл.').str.replace('Республика Крым', 'Крым').str.strip()
    merged = gdf.merge(df, left_on='name', right_on='Регион', how='left')
    merged['Cluster'] = merged['Cluster'].fillna(0).astype(int)
    fig = px.choropleth_mapbox(merged, geojson=merged.geometry, locations=merged.index,
                                color='Cluster', hover_name='name',
                                hover_data=['ЕГИСЗ','Кол. МО','Интернет','Обеспеч. врачами','Субсидии'],
                                mapbox_style="carto-positron", zoom=2, center={"lat":62,"lon":94},
                                opacity=0.7, color_continuous_scale='Viridis')
    fig.update_layout(margin={"r":0,"t":0,"l":0,"b":0})
    fig.show()

