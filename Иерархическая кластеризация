def combine_years(data):
    combined = []
    for year, df in data.items():
        df_year = df.copy()
        df_year['Год'] = year
        combined.append(df_year)
    full_df = pd.concat(combined, ignore_index=True)
    
    numeric_cols = ['ЕГИСЗ', 'Кол. МО', 'Интернет', 'Обеспеч. врачами', 'Субсидии']
    for col in numeric_cols:
        full_df[col] = pd.to_numeric(full_df[col], errors='coerce')
    
    grouped = full_df.groupby('Регион')
    numeric_means = grouped[numeric_cols].mean()
    binary_cols = ['Вендор', 'положение о ГИС']
    binary_last = grouped[binary_cols].last()
    
    result = pd.concat([numeric_means, binary_last], axis=1).reset_index()
    return result

# 2. ФУНКЦИИ ДЛЯ АНАЛИЗА МУЛЬТИКОЛЛИНЕАРНОСТИ
def calculate_vif_corrected(dataframe, exclude_cols=None):
    if exclude_cols is None:
        exclude_cols = []
    numeric_cols = dataframe.select_dtypes(include=[np.number]).columns.tolist()
    numeric_cols = [col for col in numeric_cols if col not in exclude_cols]
    X = dataframe[numeric_cols].dropna()
    if len(X) < len(numeric_cols) + 1:
        return None
    vif_data = []
    for i, col in enumerate(numeric_cols):
        X_temp = X.drop(columns=[col])
        y_temp = X[col]
        if X_temp.shape[1] == 0:
            vif = np.nan
        else:
            model = LinearRegression(fit_intercept=True)
            model.fit(X_temp, y_temp)
            r_squared = model.score(X_temp, y_temp)
            vif = 1.0 / (1.0 - r_squared) if r_squared < 0.999 else np.inf
        vif_data.append([col, vif])
    vif_df = pd.DataFrame(vif_data, columns=['Переменная', 'VIF'])
    return vif_df.sort_values('VIF', ascending=False)

def analyze_multicollinearity_complete(df, numeric_cols=None, binary_cols=None,
                                      threshold_vif=10, threshold_corr=0.8, 
                                      threshold_cramers_v=0.5):
    """Полный анализ мультиколлинеарности (без графиков, только печать)"""
    print("\n" + "="*80)
    print("ПОЛНЫЙ АНАЛИЗ МУЛЬТИКОЛЛИНЕАРНОСТИ")
    print("="*80)
    
    if numeric_cols is None:
        numeric_cols = ['ЕГИСЗ', 'Кол. МО', 'Интернет', 'Обеспеч. врачами', 'Субсидии']
    if binary_cols is None:
        binary_cols = ['Вендор', 'положение о ГИС']
    
    print(f"\nЧисловые переменные: {', '.join(numeric_cols)}")
    print(f"Бинарные переменные: {', '.join(binary_cols)}")
    
    results = {}
    
    # 1. Числовые переменные: корреляции и VIF
    if numeric_cols:
        print(f"\n--- АНАЛИЗ ЧИСЛОВЫХ ПЕРЕМЕННЫХ ---")
        numeric_df = df[numeric_cols].copy()
        corr_matrix_num = numeric_df.corr(method='spearman')
        
        # Поиск сильно коррелирующих пар
        high_corr_numeric = []
        for i in range(len(corr_matrix_num.columns)):
            for j in range(i+1, len(corr_matrix_num.columns)):
                corr_value = corr_matrix_num.iloc[i, j]
                if abs(corr_value) > threshold_corr:
                    high_corr_numeric.append({
                        'Переменная_1': corr_matrix_num.columns[i],
                        'Переменная_2': corr_matrix_num.columns[j],
                        'Корреляция': corr_value
                    })
        if high_corr_numeric:
            print(f"\nСильные корреляции (|r| > {threshold_corr}):")
            for p in high_corr_numeric:
                print(f"  {p['Переменная_1']} ↔ {p['Переменная_2']}: r = {p['Корреляция']:.3f}")
        else:
            print(f"\nСильных корреляций не обнаружено.")
        results['high_correlation_numeric'] = high_corr_numeric
        
        # VIF
        vif_results = calculate_vif_corrected(df[numeric_cols])
        if vif_results is not None:
            print("\nVIF коэффициенты:")
            print(vif_results.to_string(index=False, float_format=lambda x: f"{x:.2f}" if pd.notnull(x) else "nan"))
            high_vif = vif_results[vif_results['VIF'] > threshold_vif]
            if not high_vif.empty:
                print(f"\n Переменные с VIF > {threshold_vif}:")
                for _, row in high_vif.iterrows():
                    print(f"  {row['Переменная']}: {row['VIF']:.1f}")
            results['vif_numeric'] = vif_results
    
    # 2. Бинарные переменные: φ-коэффициент
    if binary_cols:
        print(f"\n--- АНАЛИЗ БИНАРНЫХ ПЕРЕМЕННЫХ ---")
        binary_df = df[binary_cols].copy()
        phi_matrix = pd.DataFrame(index=binary_cols, columns=binary_cols)
        for i, var1 in enumerate(binary_cols):
            for j, var2 in enumerate(binary_cols):
                if i == j:
                    phi_matrix.loc[var1, var2] = 1.0
                else:
                    contingency = pd.crosstab(binary_df[var1], binary_df[var2])
                    if contingency.shape == (2,2):
                        a,b,c,d = contingency.iloc[0,0], contingency.iloc[0,1], contingency.iloc[1,0], contingency.iloc[1,1]
                        phi = (a*d - b*c) / np.sqrt((a+b)*(c+d)*(a+c)*(b+d))
                        phi_matrix.loc[var1, var2] = phi
                    else:
                        phi_matrix.loc[var1, var2] = np.nan
        
        high_phi = []
        for i in range(len(binary_cols)):
            for j in range(i+1, len(binary_cols)):
                phi_val = phi_matrix.iloc[i, j]
                if pd.notnull(phi_val) and abs(phi_val) > threshold_cramers_v:
                    high_phi.append((binary_cols[i], binary_cols[j], phi_val))
        if high_phi:
            print(f"\nСильные связи (|φ| > {threshold_cramers_v}):")
            for v1,v2,phi in high_phi:
                print(f"  {v1} ↔ {v2}: φ = {phi:.3f}")
                           
        print("\nРаспределение бинарных переменных:")
        for var in binary_cols:
            if var in df.columns:
                counts = df[var].value_counts()
                total = counts.sum()
                prop1 = counts.get(1,0)/total if total>0 else 0
                print(f"  {var}: доля '1' = {prop1:.1%}")
        results['high_phi_pairs'] = high_phi
              
    return results

# 3. КЛАСТЕРНЫЙ АНАЛИЗ
def gower_cluster_analysis(df, n_clusters=3):
    numeric_cols = ['ЕГИСЗ', 'Кол. МО', 'Интернет', 'Обеспеч. врачами', 'Субсидии']
    binary_cols = ['Вендор', 'положение о ГИС']
    
    for col in binary_cols:
        if col in df.columns:
            df[col] = df[col].apply(lambda x: 1 if str(x).lower() in ['1','да','yes','true'] else 0)
    
    numeric_cols = [c for c in numeric_cols if c in df.columns]
    binary_cols = [c for c in binary_cols if c in df.columns]
    all_cols = numeric_cols + binary_cols
    if len(all_cols) < 2:
        raise ValueError("Мало переменных")
    
    X = df[all_cols].copy()
    gower_dist = gower_matrix(X)
    Z = linkage(gower_dist, method='ward')
    cluster_labels = fcluster(Z, n_clusters, criterion='maxclust')
    df['Cluster'] = cluster_labels
    
    df['Cluster_Distance'] = 0.0
    for cluster in range(1, n_clusters+1):
        idx = np.where(df['Cluster'] == cluster)[0]
        if len(idx) > 0:
            sub = gower_dist[idx][:, idx]
            df.loc[df['Cluster']==cluster, 'Cluster_Distance'] = sub.mean(axis=1)
    
    print(f"\nКластеризация завершена. Число кластеров: {n_clusters}")
    for c in range(1, n_clusters+1):
        cnt = (df['Cluster']==c).sum()
        print(f"  Кластер {c}: {cnt} регионов")
    return df

# 4. АНАЛИЗ КЛАСТЕРОВ
def analyze_clusters(df):
    print("\n=== СТАТИСТИКА ПО КЛАСТЕРАМ ===")
    numeric_cols = ['ЕГИСЗ', 'Кол. МО', 'Интернет', 'Обеспеч. врачами', 'Субсидии']
    binary_cols = ['Вендор', 'положение о ГИС']
    for col in numeric_cols+binary_cols:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors='coerce')
    
    stats = df.groupby('Cluster').agg({
        **{col: 'median' for col in numeric_cols if col in df.columns},
        **{col: lambda x: f"{x.mean():.1%}" for col in binary_cols if col in df.columns},
        'Регион': 'count'
    }).rename(columns={'Регион': 'Регионов'})
    
    print("\nМедианные значения по кластерам:")
    print(stats.to_string(float_format="%.2f"))
    return stats

def calculate_statistical_tests_fixed(df):
    print("\n" + "="*80)
    print("СТАТИСТИЧЕСКИЕ ТЕСТЫ")
    print("="*80)
    
    numeric_vars = ['ЕГИСЗ', 'Кол. МО', 'Интернет', 'Обеспеч. врачами', 'Субсидии']
    binary_vars = ['Вендор', 'положение о ГИС']
    numeric_vars = [v for v in numeric_vars if v in df.columns]
    binary_vars = [v for v in binary_vars if v in df.columns]
    
    # Хи-квадрат
    print("\n--- ХИ-КВАДРАТ ДЛЯ БИНАРНЫХ ПЕРЕМЕННЫХ ---")
    for var in binary_vars:
        cont = pd.crosstab(df['Cluster'], df[var])
        if cont.shape[1] >= 2:
            chi2, p, dof, _ = chi2_contingency(cont)
            sig = '***' if p<0.001 else '**' if p<0.01 else '*' if p<0.05 else 'н.з.'
            print(f"{var:20} χ²={chi2:.4f}, p={p:.4f} {sig}")
        else:
            print(f"{var:20} недостаточно данных")
    
    # Попарные сравнения
    print("\n--- ПОПАРНЫЕ СРАВНЕНИЯ ---")
    clusters = sorted(df['Cluster'].unique())
    for var in numeric_vars:
        for i, c1 in enumerate(clusters):
            for c2 in clusters[i+1:]:
                d1 = df[df['Cluster']==c1][var].dropna()
                d2 = df[df['Cluster']==c2][var].dropna()
                if len(d1)>0 and len(d2)>0:
                    _, p = mannwhitneyu(d1, d2)
                    if p < 0.05:
                        print(f"{var}: кластер {c1} vs {c2} -> p={p:.4f}")
    for var in binary_vars:
        for i, c1 in enumerate(clusters):
            for c2 in clusters[i+1:]:
                sub = df[df['Cluster'].isin([c1,c2])]
                cont = pd.crosstab(sub['Cluster'], sub[var])
                if cont.shape == (2,2):
                    _, p = fisher_exact(cont)
                    if p < 0.05:
                        print(f"{var}: кластер {c1} vs {c2} -> p={p:.4f}")

