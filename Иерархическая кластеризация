def gower_cluster_analysis(df):
    """Кластерный анализ с использованием расстояния Говера"""
    numeric_cols = ['N5', 'Кол. МО', 'Интернет', 'Обеспеч. врачами', 'Субсидии']
    binary_cols = ['Вендор', 'положение о ГИС']
    
    for col in binary_cols:
        if col in df.columns:
            df[col] = df[col].apply(lambda x: 1 if str(x).lower() in ['1', 'да', 'yes', 'true'] else 0)
    
    numeric_cols = [col for col in numeric_cols if col in df.columns]
    binary_cols = [col for col in binary_cols if col in df.columns]
    all_cols = numeric_cols + binary_cols
    
    if len(all_cols) < 2:
        raise ValueError("Недостаточно переменных для кластерного анализа")
    
    regions = df['Регион'].values if 'Регион' in df.columns else [f"Объект {i}" for i in range(len(df))]
    
    X = df[all_cols].copy()
   # if numeric_cols:
     #   scaler = StandardScaler()
     #   X[numeric_cols] = scaler.fit_transform(X[numeric_cols])
    
    gower_dist = gower_matrix(X)
    Z = linkage(gower_dist, method='ward')
    
    silhouette_scores = []
    max_clusters = min(10, len(X)-1)
    for k in range(2, max_clusters+1):
        labels = fcluster(Z, k, criterion='maxclust')
        if len(set(labels)) > 1:
            score = silhouette_score(gower_dist, labels, metric='precomputed')
            silhouette_scores.append(score)
        else:
            silhouette_scores.append(0)
    
    optimal_k = 3
    
    # Дендрограмма с названиями регионов
    plt.figure(figsize=(16, 8))
    plt.title(f'Дендрограмма кластеризации регионов', fontsize=16, pad=20)
    
    ddata = dendrogram(Z, labels=regions, leaf_rotation=90, leaf_font_size=9)
    plt.axhline(y=Z[-optimal_k, 2], color='r', linestyle='--', linewidth=2)
    plt.xlabel('Регионы', fontsize=14, labelpad=15)
    plt.ylabel('Расстояние', fontsize=14, labelpad=15)
    plt.xticks(fontsize=8)
    plt.yticks(fontsize=10)
    plt.grid(axis='y', alpha=0.3, linestyle='--')
    plt.tight_layout()
    plt.savefig('dendrogram_regions.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    cluster_labels = fcluster(Z, optimal_k, criterion='maxclust')
    df['Cluster'] = cluster_labels
    df['Cluster_Distance'] = 0.0
    
    for cluster in range(1, optimal_k+1):
        cluster_mask = df['Cluster'] == cluster
        cluster_indices = np.where(cluster_mask)[0]
        if len(cluster_indices) > 0:
            cluster_distances = gower_dist[cluster_indices][:, cluster_indices]
            df.loc[cluster_mask, 'Cluster_Distance'] = cluster_distances.mean(axis=1)
    
    print(f"\nОптимальное число кластеров: {optimal_k}")
    print(f"Силуэтный коэффициент: {max(silhouette_scores):.3f}")
    
    for cluster in range(1, optimal_k+1):
        cluster_regions = df[df['Cluster'] == cluster]['Регион'].tolist()
        print(f"\nКластер {cluster} ({len(cluster_regions)} регионов):")
        for region in cluster_regions[:10]:  # Показываем первые 10
            print(f"  - {region}")
        if len(cluster_regions) > 10:
            print(f"  ... и еще {len(cluster_regions) - 10} регионов")
    
    return df

