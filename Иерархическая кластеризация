def load_region_polygons():
    """Загружает полигоны из GeoJSON-файлов"""
    gdf = gpd.GeoDataFrame(columns=['name', 'geometry'], crs="EPSG:4326")
    
    for region_name, filename in REGION_FILES.items():
        try:
            filepath = os.path.join(REGIONS_DIR, filename)
            if not os.path.exists(filepath):
                print(f"Файл не найден: {filepath}")
                continue
                
            region_gdf = gpd.read_file(filepath)
            if not region_gdf.empty:
                gdf = pd.concat([
                    gdf,
                    gpd.GeoDataFrame({
                        'name': [region_name],
                        'geometry': [region_gdf.geometry.iloc[0]]
                    }, crs="EPSG:4326")
                ], ignore_index=True)
        except Exception as e:
            print(f"Ошибка загрузки {region_name}: {str(e)}")
    
    return gdf

def load_russia_contour_map():
    """Загружает основную карту России и добавляет регионы из файлов"""
    try:
        print("Загрузка основной карты России...")
        url = "https://raw.githubusercontent.com/codeforamerica/click_that_hood/master/public/data/russia.geojson"
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        ru_gdf = gpd.read_file(StringIO(response.text))
        
        print("Загрузка новых регионов из файлов...")
        new_regions = load_region_polygons()
        
        if not new_regions.empty:
            print(f"Добавлено регионов: {len(new_regions)}")
            ru_gdf = gpd.GeoDataFrame(
                pd.concat([ru_gdf, new_regions], ignore_index=True),
                crs="EPSG:4326"
            )
        
        ru_gdf['name'] = ru_gdf['name'].str.replace('Республика ', '')
        ru_gdf['name'] = ru_gdf['name'].str.replace('область', 'обл.')
        ru_gdf['name'] = ru_gdf['name'].str.strip()
        
        return ru_gdf
        
    except Exception as e:
        print(f"Ошибка загрузки карты: {str(e)}")
        return None

def plot_clusters_on_map(df):
    """Визуализация кластеров на карте"""
