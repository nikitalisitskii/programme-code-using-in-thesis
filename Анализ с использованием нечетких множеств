# ФУНКЦИИ ДЛЯ fsQCA АНАЛИЗА

def necessity_analysis(df, conditions, outcome):
    results = []
    for cond in conditions:
        consistency = (np.minimum(df[cond], df[outcome]).sum()) / df[outcome].sum()
        coverage = df[cond].sum() / len(df)
        results.append({'condition': cond, 'consistency': consistency, 'coverage': coverage})
    return pd.DataFrame(results)

def truth_table_with_metrics(df, conditions, outcome, cons_threshold=0.8, min_cases=2):
    df_bin = df.copy()
    for cond in conditions:
        df_bin[cond + '_bin'] = (df[cond] > 0.5).astype(int)
    
    bin_cols = [cond + '_bin' for cond in conditions]
    
    truth = df_bin.groupby(bin_cols).agg(
        n_cases=(outcome, 'count'),
        outcome_mean=(outcome, 'mean'),
        cases=('Регион', lambda x: list(x))
    ).reset_index()
    
    rename_dict = {cond + '_bin': conditions_short[cond] for cond in conditions}
    truth.rename(columns=rename_dict, inplace=True)
    truth = truth.sort_values(['outcome_mean', 'n_cases'], ascending=[False, False])
    
    high_outcome_mask = df[outcome] > 0.6
    total_high = high_outcome_mask.sum()
    
    raw_coverages = []
    for _, row in truth.iterrows():
        mask = pd.Series(True, index=df.index)
        for cond_short, val in zip(conditions_short.values(), [row[cond_short] for cond_short in conditions_short.values()]):
            original_cond = [k for k, v in conditions_short.items() if v == cond_short][0]
            if val == 1:
                mask &= (df[original_cond] > 0.5)
            else:
                mask &= (df[original_cond] <= 0.5)
        covered_high = (mask & high_outcome_mask).sum()
        raw_cov = covered_high / total_high if total_high > 0 else 0
        raw_coverages.append(raw_cov)
    
    truth['raw_coverage'] = raw_coverages
    truth['sufficient'] = truth['outcome_mean'] >= cons_threshold
    truth = truth[truth['n_cases'] >= min_cases].reset_index(drop=True)
    return truth, total_high

