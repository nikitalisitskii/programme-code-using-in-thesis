# ФУНКЦИИ ДЛЯ КАЛИБРОВКИ

def calibrate_linear(x, p0, p05, p1):
    """Линейная калибровка"""
    if x <= p0:
        return 0.0
    elif x >= p1:
        return 1.0
    else:
        return 1 / (1 + np.exp(-((x - p05) / (p1 - p0) * 9.2)))

def calibrate_log(x, p0, p05, p1):
    """Логарифмическая калибровка"""
    x_safe = max(x, 0)
    x_log = np.log1p(x_safe)
    p0_log = np.log1p(max(p0, 0))
    p05_log = np.log1p(max(p05, 0))
    p1_log = np.log1p(max(p1, 0))
    
    if x_log <= p0_log:
        return 0.0
    elif x_log >= p1_log:
        return 1.0
    else:
        return 1 / (1 + np.exp(-((x_log - p05_log) / (p1_log - p0_log) * 9.2)))

def select_calibration_method(data, var):
    """Статистически обоснованный выбор метода калибровки"""
    values = data[var].dropna()
    
    cv = values.std() / values.mean() if values.mean() != 0 else float('inf')
    skewness = stats.skew(values)
    
    use_log = False
    reason = []
    
    if cv > 1.0:
        use_log = True
        reason.append(f"высокий коэф.вариации ({cv:.2f})")
    if skewness > 1.5:
        use_log = True
        reason.append(f" ({skewness:.2f})")
    if var in ['Субсидии', 'Кол. МО']:
        use_log = True
        reason.append("")
    
    # Определение порогов
    if var == 'Кол. МО':
        data_without_outliers = values[values < values.quantile(0.99)]
        p0 = data_without_outliers.quantile(0.05)
        p05 = data_without_outliers.quantile(0.50)
        p1 = data_without_outliers.quantile(0.95)
    elif var == 'Субсидии':
        p0 = values.quantile(0.10)
        p05 = values.quantile(0.50)
        p1 = values.quantile(0.90)
    else:
        p0 = values.quantile(0.05)
        p05 = values.quantile(0.50)
        p1 = values.quantile(0.95)
    
    # Защита от совпадения порогов
    if p0 == p05 or p05 == p1:
        p0 = values.min()
        p1 = values.max()
        p05 = values.median()
    
    return {
        'var': var,
        'use_log': use_log,
        'p0': p0,
        'p05': p05,
        'p1': p1,
        'cv': cv,
        'skewness': skewness,
        'reason': '; '.join(reason) if reason else ""
    }

